# 复制为 .env 后填写（cp .env.example .env）；.env 不进 git
# 所有项在 app/config.py 有兜底默认值，除注明必填外都可省略

# ─── LLM：阿里云百炼 DashScope（OpenAI 兼容接口）───
DASHSCOPE_API_KEY=sk-必填-你的百炼APIKey
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型分槽：主 agent 与解析 sub-agent 各配各的（换模型只改这里，代码不动）
DASHSCOPE_MODEL=qwen3.7-flash
DASHSCOPE_FAST_MODEL=qwen3.7-flash
# 主 agent 思考模式（qwen3 思考型模型；可靠性优先，建议开）
DASHSCOPE_ENABLE_THINKING=true

# ─── 向量召回（可选，默认关：n-gram 关键词路够用时不多养一条 API 依赖）───
# 开启步骤：① EMBEDDING_ENABLED=true（改 .env 后 touch app/config.py 触发重载）
#          ② 跑 .venv/bin/python scripts/backfill_embeddings.py 回填存量记录
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=text-embedding-v3

# ─── 高德天气 MCP（可选：不配则天气功能自动降级，其余不受影响）───
# 注意 key 类型必须是「Web服务」
AMAP_MAPS_API_KEY=
MCP_AMAP_ENABLED=true

# ─── 其他 ───
# 晨间总览/天气查询的默认城市
BRIEFING_CITY=北京
